# Server
PORT=3000

# Auth (wajib: minimal 32 karakter, ganti dengan nilai acak sendiri)
JWT_SECRET=isi_dengan_secret_acak_minimal_32_karakter
JWT_EXPIRES_IN=24h

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=ganti_dengan_password_postgres_lokal
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME_DEV=gohaur-dev
DB_NAME_TEST=gohaur-test
DB_NAME_PROD=gohaur-prod
