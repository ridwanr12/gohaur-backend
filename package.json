{
  "name": "gohaur-backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"app.js\" \"src/**/*.js\"",
    "format:check": "prettier --check \"app.js\" \"src/**/*.js\"",
    "verify": "npm run lint && npm test",
    "db:create": "sequelize-cli db:create --config src/config/config.js",
    "db:migrate": "sequelize-cli db:migrate --config src/config/config.js --migrations-path src/migrations --seeders-path src/seeders --models-path src/models",
    "db:migrate:status": "sequelize-cli db:migrate:status --config src/config/config.js --migrations-path src/migrations --seeders-path src/seeders --models-path src/models",
    "db:seed": "sequelize-cli db:seed:all --config src/config/config.js --migrations-path src/migrations --seeders-path src/seeders --models-path src/models"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^8.3.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^2.8.8",
    "sequelize-cli": "^6.6.5"
  }
}
